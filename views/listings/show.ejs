<% layout("/layouts/boilerplate") %>

<div class="row mt-4">
  <div class="col-8 offset-3">
    <h3><%= listing.title %></h3>
  </div>

  <div class="card col-6 offset-3 show-card listing-card">
    <img 
      src="<%= listing.image?.url || '#' %>"
      class="card-img-top show-img"
      alt="listing_image" 
    />
    <div class="card-body">
     <p class="mb-3">
            <i class="fa-solid fa-user"></i>
            Hosted by
            <strong><%= listing.owner?.username || "Unknown" %></strong>
          </p>
      <p class="card-text"><%= listing.description %></p>
      <p class="card-text">&#8377;<%= listing.price?.toLocaleString("en-IN") || "N/A" %></p>
     <p class="card-text">
    <i class="fa-solid fa-location-dot text-danger"></i>
    <%= listing.location %>, <%= listing.country %>
</p>
    </div>
  </div>
</div>

<br />

<!-- Booking Form (Logged-in users except owner) -->
<% if(currUser && !listing.owner?._id.equals(currUser._id)) { %>
<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="card shadow-sm border-0 rounded-4 p-4">
      <h4 class="fw-bold mb-3">
        <i class="fa-solid fa-calendar-check text-danger"></i>
        Reserve Your Stay
      </h4>
      <form action="/listings/<%= listing._id %>/bookings" method="POST">
        <div class="mb-3">
          <label for="startDate" class="form-label fw-semibold">
            Check-in
          </label>
          <input
            type="date"
            id="startDate"
            name="startDate"
            class="form-control rounded-3"
            required>
        </div>
        <div class="mb-4">
          <label for="endDate" class="form-label fw-semibold">
            Check-out
          </label>
          <input
            type="date"
            id="endDate"
            name="endDate"
            class="form-control rounded-3"
            required>
        </div>
        <button type="submit" class="btn add-btn w-100">
          <i class="fa-solid fa-bed"></i>
          Reserve Now
        </button>
      </form>
    </div>
  </div>
</div>
<script>
const startInput = document.getElementById("startDate");
const endInput = document.getElementById("endDate");
const today = new Date().toISOString().split("T")[0];
startInput.min = today;
endInput.min = today;
startInput.addEventListener("change", () => {
    endInput.min = startInput.value || today;

    if (endInput.value && endInput.value < endInput.min) {
        endInput.value = "";
    }
});
</script>
<% } %>


<!-- Display Existing Bookings -->
<% if(bookings && bookings.length > 0) { %>
<div class="col-md-8 mx-auto mt-3 mb-4">
  <h5 class="fw-bold mb-3">
    <i class="fa-solid fa-calendar-check text-danger"></i>
    Reserved Dates
</h5>
 <div>
    <% bookings.forEach(b => { %>
      <div class="card border-0 shadow-sm mb-2 p-3">
    <strong>
        <%= new Date(b.startDate).toLocaleDateString("en-IN") %>
        -
        <%= new Date(b.endDate).toLocaleDateString("en-IN") %>
    </strong>
</div>
    <% }) %>
 </div>
</div>
<% } %>

<!-- Edit/Delete buttons for owner -->
<% if(currUser && listing.owner?._id.equals(currUser._id)) { %>
<div class="btns">
  <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark col-1 offset-3 edit-btn">Edit</a>
  <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
    <button class="btn btn-dark offset-5">Delete</button>
  </form>
</div>
<% } %>

<!-- Reviews Section -->
<div class="col-md-8 mx-auto mt-5 mb-4">
  <% if(currUser) { %>
    <h4>Leave a Review</h4>
    <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
      <div class="mb-3 mt-3">
        <label for="rating" class="form-label">Rating</label>
        <fieldset class="starability-slot">
          <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
          <input type="radio" id="first-rate1" name="review[rating]" value="1" />
          <label for="first-rate1" title="Terrible">1 star</label>
          <input type="radio" id="first-rate2" name="review[rating]" value="2" />
          <label for="first-rate2" title="Not good">2 stars</label>
          <input type="radio" id="first-rate3" name="review[rating]" value="3" />
          <label for="first-rate3" title="Average">3 stars</label>
          <input type="radio" id="first-rate4" name="review[rating]" value="4" />
          <label for="first-rate4" title="Very good">4 stars</label>
          <input type="radio" id="first-rate5" name="review[rating]" value="5" />
          <label for="first-rate5" title="Amazing">5 stars</label>
        </fieldset>
      </div>
      <div class="mb-3 mt-3">
        <label for="comment" class="form-label">Comments</label>
        <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control" required></textarea>
        <div class="invalid-feedback">Please add some comments for review</div>
      </div>
      <button class="btn btn-outline-dark">Submit</button>
    </form>
    <hr />
  <% } %>

  <p><b>Guest Reviews</b></p>
  <div class="row">
    <% listing.reviews.forEach(review => { %>
      <div class="card col-5 ms-3 mb-3">
        <div class="card-body">
          <h5 class="card-title">@<%= review.author?.username || 'Unknown' %></h5>
          <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>
          <p class="card-text"><%= review.comment %></p>
        </div>
        <% if(currUser && review.author?._id.equals(currUser._id)) { %>
        <form class="mb-3" method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
          <button class="btn btn-sm btn-dark mt-3">Delete</button>
        </form>
        <% } %>
      </div>
    <% }) %>
  </div>
</div>
