<% layout("/layouts/boilerplate") %>

<!-- Heading -->
<div class="mt-4">
  <h2>
    <% if (typeof search !== "undefined" && search && search.trim() !== "") { %>
      Results for "<%= search %>"
    <% } else if (typeof category !== "undefined" && category && category.trim() !== "") { %>
      Showing: <%= category %> Listings
    <% } %>
  </h2>
</div>

<style>
  #filters {
    display: flex;
    flex-wrap: wrap;  
    align-items: center;
  }

  .filter {
    text-align: center;
    opacity: 0.7;
     margin-right: 2rem;
    margin-top: 1rem;
  }
  .filter:hover {
    opacity: 1;
    cursor: pointer;
  }
  .filter p {
    font-size: 0.8rem;
  }
  .filter a {
    text-decoration: none;
    color: inherit;
  }

  .tax-info {
    display: none;
  }

  .tax-toggle {
    border: 1px solid black;
    border-radius: 1rem;
    height: auto;
    padding: 0.5rem 1rem;
    margin-left: 0;
    margin-top: 1rem;
    display: flex;
    align-items: center;
  }

  /*Responsive image */
  .show-img {
    object-fit: cover;
    height: 200px;
    width: 100%;
  }
</style>

<!-- Filters -->
<div id="filters">
  <!-- Show All -->
  <div class="filter">
    <a href="/listings" class="<%= !category ? 'active' : '' %>">
      <i class="fa-solid fa-globe"></i>
      <p>Show All</p>
    </a>
  </div>

  <!-- Trending -->
  <div class="filter">
    <a href="/listings?category=Trending" class="<%= category === 'Trending' ? 'active' : '' %>">
      <i class="fa-solid fa-fire-flame-curved"></i>
      <p>Trending</p>
    </a>
  </div>

  <!-- Rooms -->
  <div class="filter">
    <a href="/listings?category=Rooms" class="<%= category === 'Rooms' ? 'active' : '' %>">
      <i class="fa-solid fa-bed"></i>
      <p>Rooms</p>
    </a>
  </div>

  <!-- Iconic Cities -->
  <div class="filter">
    <a href="/listings?category=Iconic Cities" class="<%= category === 'Iconic Cities' ? 'active' : '' %>">
      <i class="fa-solid fa-city"></i>
      <p>Iconic Cities</p>
    </a>
  </div>

  <!-- Mountains -->
  <div class="filter">
    <a href="/listings?category=Mountains" class="<%= category === 'Mountains' ? 'active' : '' %>">
      <i class="fa-solid fa-mountain-sun"></i>
      <p>Mountains</p>
    </a>
  </div>

  <!-- Castles -->
  <div class="filter">
    <a href="/listings?category=Castles" class="<%= category === 'Castles' ? 'active' : '' %>">
      <i class="fa-brands fa-fort-awesome"></i>
      <p>Castles</p>
    </a>
  </div>

  <!-- Amazing Pools -->
  <div class="filter">
    <a href="/listings?category=Amazing Pools" class="<%= category === 'Amazing Pools' ? 'active' : '' %>">
      <i class="fa-solid fa-person-swimming"></i>
      <p>Amazing Pools</p>
    </a>
  </div>

  <!-- Camping -->
  <div class="filter">
    <a href="/listings?category=Camping" class="<%= category === 'Camping' ? 'active' : '' %>">
      <i class="fa-solid fa-campground"></i>
      <p>Camping</p>
    </a>
  </div>

  <!-- Farms -->
  <div class="filter">
    <a href="/listings?category=Farms" class="<%= category === 'Farms' ? 'active' : '' %>">
      <i class="fa-solid fa-tractor"></i>
      <p>Farms</p>
    </a>
  </div>

  <!-- Flat -->
  <div class="filter">
    <a href="/listings?category=Flat" class="<%= category === 'Flat' ? 'active' : '' %>">
      <i class="fa-solid fa-building"></i>
      <p>Flat</p>
    </a>
  </div>

  <!-- Arctic -->
  <div class="filter">
    <a href="/listings?category=Arctic" class="<%= category === 'Arctic' ? 'active' : '' %>">
      <i class="fa-solid fa-snowman"></i>
      <p>Arctic</p>
    </a>
  </div>

  <!-- Tax Toggle -->
  <div class="tax-toggle">
    <div class="form-check-reverse form-switch">
      <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
      <label class="form-check-label" for="switchCheckDefault">
        Display total after taxes
      </label>
    </div>
  </div>
</div>

<!-- Listings Grid -->
<% if (!allListings || allListings.length === 0) { %>
  <p class="text-muted mt-3">
    No listings found
    <% if (search) { %> for "<%= search %>" <% } %>.
  </p>
<% } else { %>
  <!--grid for responsiveness -->
  <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4 mt-3">
    <% for (let listing of allListings) { %>
      <div class="col">
        <a href="/listings/<%= listing._id %>" class="listing-link">
          <div class="card listing-card h-100">
            <img src="<%= listing.image.url %>" 
                 class="card-img-top show-img" 
                 alt="listing image" />
            <div class="card-body">
              <p class="card-text">
                <b><%= listing.title %></b> <br />
                <% if (listing.price != null) { %>
                  &#8377; <%= listing.price.toLocaleString("en-IN") %> / night
                  <i class="tax-info"> &nbsp; &nbsp; +18% GST</i>
                <% } %>
              </p>
            </div>
          </div>
        </a>
      </div>
    <% } %>
  </div>
<% } %>

<script>
  let taxSwitch = document.getElementById("switchCheckDefault");
  taxSwitch.addEventListener("click", () => {
    let taxInfo = document.getElementsByClassName("tax-info");
    for (let info of taxInfo) {
      if (info.style.display !== "inline") {
        info.style.display = "inline";
      } else {
        info.style.display = "none";
      }
    }
  });
</script>
