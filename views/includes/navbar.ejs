<style>
.navbar-collapse {
  background: #fff;      
  z-index: 1000;          
}

@media (max-width: 768px) {
  .navbar-collapse.show {
    margin-bottom: 1rem;
  }
}

.navbar-brand {
    font-family:'Trebuchet MS', 'Gill Sans', sans-serif;
    font-size: 1.7rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    color: #E63946 !important;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

  .navbar-brand i {
    font-size: 1.5rem;
  }

  .search-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background:#E63946;
    color: #fff;
    border-radius: 25px;
    padding: 0 1rem;
    border: none;
  }

  .search-btn:hover {
   background:#D62839;
    color: #fff;
  }

  .search-inp {
    border-radius: 25px;
    padding: 0.5rem 1rem;
    font-size: 1rem;
    min-width: 180px;    
  }

  .btn-signup {
    border-radius: 25px;
    padding: 0.35rem 1rem;
    background:#E63946;
    color: #fff;
    border: none;
  }

  .btn-signup:hover {
    background:#D62839;
    color: #fff;
  }
  .nav-link{
    font-weight:500;
    transition:0.3s;
}

.nav-link:hover{
    color:#D62839 !important;
}

.navbar-nav{
    gap:0.6rem;
    align-items:center;
}

.nav-link{
    padding:0.4rem 0.7rem !important;
    border-radius:10px;
}

.nav-link:hover{
    background:#f8f8f8;
}

  /*Mobile tweaks only */
  @media (max-width: 576px) {
    .search-inp{
    width:220px;
    border-radius:25px;
}
    .search-btn {
      padding:0.55rem 1rem;
      font-size: 0.9rem;
    }

    /* keep nav links right aligned */
    .navbar-nav {
      align-items: flex-start; 
    }
    .navbar-nav .nav-link,
    .navbar-nav .btn-signup {
      text-align: right;     
      width: 100%;
    }
  }
</style>

<nav class="navbar navbar-expand-md bg-white shadow-sm sticky-top">
  <div class="container-fluid">
    <!-- Brand -->
    <a class="navbar-brand" href="/listings">
      <i class="fa-solid fa-location-dot"></i> StaySpot
    </a>

    <!-- Toggler for mobile -->
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup">
      <span class="navbar-toggler-icon"></span>
    </button>

    <!-- Collapsible content -->
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      
      <!-- Search Form -->
      <form class="d-flex mx-md-auto my-2 my-md-0" role="search" action="/listings" method="GET">
        <input 
          class="form-control search-inp me-2" 
          type="search" 
          name="search" 
          placeholder="Search by location" 
          value="<%= typeof search !== 'undefined' ? search : '' %>" 
          required
        />
        <button class="btn search-btn" type="submit">
          <i class="fa-solid fa-magnifying-glass"></i> Search
        </button>
      </form>

      <!-- Right-side links -->
       <div class="navbar-nav ms-auto align-items-center">

  <a class="nav-link me-3" href="/listings/new">
    <i class="fa-solid fa-house"></i> Become a Host
  </a>

  <% if (!currUser) { %>

    <a class="nav-link me-3" href="/login">
      Log in
    </a>

    <a class="btn btn-signup" href="/signup">
      Sign Up
    </a>

  <% } %>

  <% if (currUser) { %>

    <a class="nav-link" href="/logout">
      Log out
    </a>

  <% } %>

</div>
    </div>
  </div>
</nav>
