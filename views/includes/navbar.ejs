<style>
  .navbar-brand {
    font-family: 'Brush Script MT', cursive;
    font-size: 1.8rem;
    color: #fe424d;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .navbar-brand i {
    font-size: 1.5rem;
  }

  .search-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background-color: #fe424d;
    color: #fff;
    border-radius: 25px;
    padding: 0 1rem;
    border: none;
  }

  .search-btn:hover {
    background-color: #fe424d;
    color: #fff;
  }

  .search-inp {
    border-radius: 25px;
    padding: 0.5rem 3rem;
    font-size: 1rem;
  }

  .nav-link i {
    margin-right: 0.3rem;
  }

  .btn-signup {
    border-radius: 25px;
    padding: 0.35rem 1rem;
    background-color: #fe424d;
    color: #fff;
    border: none;
  }

  .btn-signup:hover {
    background-color: #ff6b74;
    color: #fff;
  }
</style>

<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
  <div class="container-fluid">
    <!-- Brand -->
    <a class="navbar-brand" href="/listings">
      <i class="fa-regular fa-compass"></i> Wanderlust
    </a>

    <!-- Toggle button for mobile -->
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      
      <!-- Middle: Search Form -->
      <div class="mx-auto">
        <form class="d-flex" role="search" action="/listings" method="GET">
          <input 
            class="form-control me-2 search-inp" 
            type="search" 
            name="search" 
            placeholder="Search by location" 
            value="<%= typeof search !== 'undefined' ? search : '' %>" 
            required
          />
          <button class="btn search-btn" type="submit">
            <i class="fa-solid fa-magnifying-glass"></i> Search
          </button>
        </form>
      </div>

      <!-- Right-side links -->
      <div class="navbar-nav ms-auto align-items-center">
        <a class="nav-link" href="/listings">
        Explore
        </a>

        <a class="nav-link" href="/listings/new">
          <i class="fa-solid fa-house"></i> Airbnb your home
        </a>

        <% if (!currUser) { %>
          <a class="btn btn-signup ms-2" href="/signup">
            <i class="fa-regular fa-user-plus"></i> Sign up
          </a>
          <a class="nav-link ms-2" href="/login">
            <i class="fa-solid fa-right-to-bracket"></i> Log in
          </a>
        <% } %>

        <% if (currUser) { %>
          <a class="nav-link ms-2" href="/logout">
            <i class="fa-solid fa-right-from-bracket"></i> Log out
          </a>
        <% } %>
      </div>
    </div>
  </div>
</nav>
